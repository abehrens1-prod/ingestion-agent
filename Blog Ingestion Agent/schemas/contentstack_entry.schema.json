{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "contentstack_entry.schema.json",
  "title": "Contentstack Blog Entry",
  "type": "object",
  "required": ["entry"],
  "properties": {
    "entry": {
      "type": "object",
      "required": ["title", "url"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^/" },
        "subtitle": { "type": "string" },
        "author": { "type": "string" },
        "publish_date": { "type": "string" },
        "meta_title": { "type": "string" },
        "meta_description": { "type": "string" },
        "target_keywords": {
          "type": "array",
          "items": { "type": "string" }
        },
        "quick_answer": {
          "type": "array",
          "items": { "type": "string" }
        },
        "body": {},
        "faq": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["question", "answer"],
            "properties": {
              "question": { "type": "string" },
              "answer": { "type": "string" },
              "accordionEnabled": { "type": "boolean" }
            }
          }
        },
        "cta": {
          "type": "object",
          "properties": {
            "headline": { "type": "string" },
            "body": { "type": "string" },
            "buttonText": { "type": "string" },
            "buttonUrl": { "type": "string" }
          }
        },
        "hero_image": {
          "type": "object",
          "properties": {
            "uid": { "type": "string" },
            "url": { "type": "string" }
          }
        },
        "video_embed": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "embedType": { "type": "string" }
          }
        }
      }
    }
  }
}
